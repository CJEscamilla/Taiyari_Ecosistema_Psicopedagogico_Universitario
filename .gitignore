# ============================================
# A-TENCIÓN · .gitignore
# ============================================

# -------- Dependencias --------
node_modules/
**/node_modules/
jspm_packages/

# -------- Variables de entorno (secretos) --------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# -------- Artefactos de build --------
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts.bak

# -------- Logs --------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# -------- Cache / temporales --------
.npm
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tgz
*.tmp
*.temp

# -------- Coverage / testing --------
coverage/
.nyc_output/
*.lcov

# -------- TypeScript --------
*.tsbuildinfo
tsconfig.tsbuildinfo

# -------- IDEs / editores --------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.history/

# -------- Sistema operativo --------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -------- Yarn (no se usa) --------
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarnrc.yml
.pnp.*

# -------- Misc --------
*.pem
*.key
*.crt
.env.vault
.vercel