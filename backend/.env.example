# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3001
# Puerto donde corre el backend Express (default: 3001)

NODE_ENV=development
# development | production

FRONTEND_URL=http://localhost:3000
# URL del frontend Next.js (para CORS y redirects de Stripe)


# ============================================
# BASE DE DATOS MYSQL (MySQL Workbench)
# ============================================
# Estas credenciales son las que usa tu MySQL Workbench local

DB_HOST=localhost
# Host del servidor MySQL (generalmente localhost para desarrollo local)

DB_PORT=3306
# Puerto de MySQL (default 3306)

DB_USER=root
# Usuario de MySQL (por defecto es 'root' en XAMPP/WAMP/MAMP)

DB_PASSWORD=
# Contraseña de MySQL (dejar vacío si no tiene password en local)

DB_NAME=sensorial_db
# Nombre de la base de datos que crearás en MySQL Workbench


# ============================================
# AUTENTICACIÓN JWT
# ============================================
# Genera un string aleatorio seguro para firmar los tokens JWT
# Puedes generar uno en: https://jwtsecret.com/generate
# O correr en terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=tu_jwt_secret_super_seguro_minimo_32_caracteres_aqui
# Secreto para firmar tokens JWT (cambiar en producción!)

JWT_EXPIRES_IN=7d
# Tiempo de expiración del token (7d = 7 días, 24h = 24 horas)


# ============================================
# STRIPE - PASARELA DE PAGOS (API EXTERNA #1)
# ============================================
# 1. Crear cuenta en: https://dashboard.stripe.com/register
# 2. Ir a: Developers > API Keys
# 3. Copiar la "Secret key" (empieza con sk_test_ para modo test)
# 4. Para Webhook Secret: ir a Developers > Webhooks > Add endpoint
#    - Endpoint URL: http://localhost:3001/api/stripe/webhook
#    - Events: checkout.session.completed
#    - Copiar el "Signing secret" (empieza con whsec_)

STRIPE_SECRET_KEY=sk_test_tu_secret_key_de_stripe_aqui
# Secret Key de Stripe (obtenido del Dashboard de Stripe)

STRIPE_PUBLISHABLE_KEY=pk_test_tu_publishable_key_aqui
# Publishable Key (solo si se usa en frontend directamente)

STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui
# Webhook Secret para verificar eventos de Stripe (opcional en desarrollo)


# ============================================
# RESEND - EMAIL TRANSACCIONAL (API EXTERNA #2)
# ============================================
# 1. Crear cuenta gratuita en: https://resend.com
# 2. Ir a: API Keys > Create API Key
# 3. Dar nombre: "Sensorial API"
# 4. Copiar la API Key (empieza con re_)
# 5. Verificar un dominio o usar el dominio de prueba: onboarding@resend.dev

RESEND_API_KEY=re_tu_api_key_de_resend_aqui
# API Key de Resend (obtenida del dashboard de Resend)

RESEND_FROM_EMAIL=onboarding@resend.dev
# Email remitente (usa tu dominio verificado o onboarding@resend.dev para pruebas)

RESEND_FROM_NAME=A-TENCIÓN
# Nombre que aparecerá como remitente en los correos

RESEND_OVERRIDE_TO=
# (Opcional) En plan free Resend solo permite enviar al email con el que
# te registraste. Define aquí tu email registrado y TODOS los correos se
# redirigirán ahí durante desarrollo. Dejar vacío para usar el destinatario real.


# ============================================
# ADMIN EMAILS (Hardcoded - NO CAMBIAR)
# ============================================
# Lista de correos que tendrán rol de administrador automáticamente
# Estos son los correos institucionales proporcionados

ADMIN_EMAILS=240508@utxicotepec.edu.mx,240687@utxicotepec.edu.mx,240463@utxicotepec.edu.mx,240071@utxicotepec.edu.mx
# Correos separados por coma - NO MODIFICAR ESTA LÍNEA
